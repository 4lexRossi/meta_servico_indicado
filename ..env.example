# =============================================================================
# AWS Configuration for Serviço Indicado
# =============================================================================

# Região AWS (Recomendado: sa-east-1 para São Paulo)
AWS_REGION=

# Suas credenciais IAM da AWS (com permissões para DynamoDB e S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DynamoDB
DYNAMODB_TABLE_NAME=

# AWS S3 (Armazenamento Standard de Fotos e Portfólio)
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=
